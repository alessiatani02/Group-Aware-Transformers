#!/bin/bash
#PBS -N train_50k_gpu
#PBS -q gpu
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -o /work/u10767335/pbs_logs/train_50k.out
#PBS -e /work/u10767335/pbs_logs/train_50k.err
#PBS -j oe

echo "Job started on $(hostname)"

cd /work/u10767335/thesis-mixed-effects/paper_code/nli-mixed-models-master

source ~/my_envs/thesis_env/bin/activate

export PYTHONPATH=$PYTHONPATH:/work/u10767335/thesis-mixed-effects/paper_code/nli-mixed-models-master

echo "Checking GPU..."
nvidia-smi

echo "Starting training..."

python -u scripts/categorical/train_categorical_nli.py \
    --parameters scripts/categorical/train_categorical_nli.json

echo "Job finished"
